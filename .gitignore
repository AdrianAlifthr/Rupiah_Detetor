# =========================
# Root project ignores
# =========================

# OS / editor
.DS_Store
Thumbs.db
.vscode/*.log

# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Jupyter
.ipynb_checkpoints/

# =========================
# ML training generated / downloadable artifacts
# =========================
ml_training/dataset/processed/
ml_training/output/
ml_training/dataset/raw/
ml_training/.fiftyone/
ml_training/zoo/
ml_training/downloads/

# =========================
# Flutter build artifacts (if root git tracks full repo)
# =========================
app/.dart_tool/
app/.flutter-plugins-dependencies
app/build/
app/.idea/
app/android/.gradle/
app/android/local.properties
app/pubspec.lock

# Optional local model assets in app (generated from ml_training output)
# Uncomment if you don't want model binaries committed
# app/assets/model/rupiah_model.tflite
# app/assets/model/labels.txt
